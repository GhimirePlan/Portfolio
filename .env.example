# Development Environment Variables
# Copy this file to .env.local and fill in the values

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your-database?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# PlanBot Configuration
GROQ_API_KEY=your-groq-api-key

# GitHub (live portfolio content: profile, projects, skills)
GITHUB_USERNAME=GhimirePlan
# Optional: raises GitHub API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=



# Optional: Google Analytics
NEXT_PUBLIC_GA_ID=

# Optional: API Keys for external services
# NEXT_PUBLIC_API_KEY=

NEXT_PUBLIC_GTM =
NEXT_PUBLIC_APP_URL = 
TELEGRAM_BOT_TOKEN = 
TELEGRAM_CHAT_ID = 
GMAIL_PASSKEY = 
EMAIL_ADDRESS =
# Contact form: credentials must be configured in the deployment environment.
# EMAIL_ADDRESS and GMAIL_PASSKEY above are supported for Gmail.
# Use a matching reCAPTCHA v3 pair, registered for plan.com.np and www.plan.com.np.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional server-side alias for the public site key (read at runtime).
RECAPTCHA_SITE_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=plan.com.np,www.plan.com.np
# Optional SMTP provider (takes precedence over the Gmail variables)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CONTACT_EMAIL=contact@plan.com.np

# Optional: preferred Groq model; supported fallback models remain enabled.
GROQ_MODEL=openai/gpt-oss-20b

# Discord visitor and new-chat notifications (server-only webhook URL).
DISCORD_WEBHOOK_URL=

# Optional Developer Status integrations; toggles default off in admin.
DISCORD_USER_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
